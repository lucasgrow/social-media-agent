#!/usr/bin/env python3
"""Auto-generated craft.py for {{profile}}/{{slug}}.

Generated by /social-media-agent post. Edit freely — this file is materialized once
from the social_media_agent template and then becomes yours.

Engine is selected per-profile (DESIGN.md default_engine, baked here as ENGINE). It
dispatches via the engine registry, so switching openai_gpt_image_2 <-> gemini_image
is a one-word change. Grounded subject refs (refs/grounded/, populated by Workflow G)
lead the reference list ahead of brand pages.
"""
import os
import sys
from pathlib import Path

from social_media_agent.brand.brand_loader import list_brand_pages, parse_design_md, parse_voice_md
from social_media_agent.brand.prompt_builder import build_prompt
from social_media_agent.engines import get_engine
from social_media_agent.engines.spec import resolve_gen_kwargs
from social_media_agent.grounding.ground import collect_grounded_refs
from social_media_agent.render.image_renderer import save
from social_media_agent.utils.env import find_repo_root, load_env

HERE = Path(__file__).resolve()
# Walk up to pyproject.toml to locate profiles/ and .env. The implementation is
# imported from the installed social_media_agent package above (no sys.path hack).
REPO_ROOT = find_repo_root(HERE)

PROFILE = REPO_ROOT / "profiles" / "{{profile}}"
POST_DIR = HERE.parent
OUTPUT = POST_DIR / "outputs" / "v1" / "{{output_filename}}"

ENGINE = "{{engine}}"
FORMAT = "{{format}}"


def main():
    load_env(REPO_ROOT / ".env", inject=True)

    engine = get_engine(ENGINE)
    api_key = os.environ.get(engine.API_KEY_ENV)
    if not api_key:
        sys.exit(f"ERROR: {engine.API_KEY_ENV} not set in .env or environment (engine: {ENGINE})")

    design_meta, _ = parse_design_md(PROFILE / "brand-kit" / "DESIGN.md")
    voice_meta, _ = parse_voice_md(PROFILE / "VOICE.md")
    brand_pages = list_brand_pages(PROFILE / "brand-kit" / "pages")

    # Source layout refs (from ingest into source/) + grounded subject refs (Workflow G).
    source_dir = POST_DIR / "source"
    source_refs = sorted(
        p for p in source_dir.iterdir()
        if p.is_file() and p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp")
    ) if source_dir.exists() else []
    grounded_refs = collect_grounded_refs(POST_DIR)
    print(f"[craft] engine={ENGINE} brand={len(brand_pages)} source={len(source_refs)} grounded={len(grounded_refs)}")
    if not brand_pages:
        print(
            "[craft] WARNING: no brand pages loaded from brand-kit/pages/ — output will lack the "
            "brand style anchor. Check the dir has png/jpg/jpeg/webp images.",
            file=sys.stderr,
        )

    task = {{task_repr}}

    text_prompt, image_refs = build_prompt(
        task=task,
        design=design_meta,
        voice=voice_meta,
        brand_pages=brand_pages,
        extra_refs=source_refs,
        grounded_refs=grounded_refs,
        ref_limit=engine.MAX_REFS,
    )
    print(f"[craft] prompt {len(text_prompt)} chars + {len(image_refs)} image refs (max {engine.MAX_REFS})")

    gen_kwargs = resolve_gen_kwargs(ENGINE, FORMAT)

    # edit() when we have anything to anchor to (grounded subject or source layout);
    # otherwise pure text-to-image. brand_pages alone don't force edit().
    if grounded_refs or source_refs:
        png_bytes = engine.edit(api_key=api_key, prompt=text_prompt, images=image_refs, **gen_kwargs)
    else:
        png_bytes = engine.generate(api_key=api_key, prompt=text_prompt, **gen_kwargs)
    print(f"[craft] generated {len(png_bytes) // 1024} KB")

    save(png_bytes, OUTPUT)
    print(f"[craft] saved → {OUTPUT}")


if __name__ == "__main__":
    main()
