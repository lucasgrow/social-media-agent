# Optional: override the meta-project root. Resolved from cwd otherwise.
# SOCIAL_MEDIA_AGENT_HOME=

# OpenAI — for gpt-image-2 (image generation + editing)
OPENAI_API_KEY=sk-proj-...

# Google Gemini — for gemini-3-pro-image-preview (engine: gemini_image; grounded
# subjects, faces/scenes, up to 14 refs) + grounding extract/verify fallback.
GEMINI_API_KEY=AIza...

# Serper.dev — OPTIONAL. Tertiary source for grounding reference-image search
# (Workflow G). Unset = the agent just asks you for photos / uses Chrome web search.
# SERPER_API_KEY=

# Twitter API (twitterapi.io) — optional, for tweet text/thread extraction
TWITTER_API_KEY=...

# Cobalt API — used for IG image/carousel ingest (yt-dlp is video-only).
# Default is the LOCAL instance provisioned by this repo:
#   python -m social_media_agent.cobalt ensure
# Only set this to point at a different Cobalt instance.
# COBALT_API_URL=http://127.0.0.1:9000/
# COBALT_API_KEY=
